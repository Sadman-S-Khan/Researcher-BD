# Environment variables for Researcher BD
# Copy this file to `.env` and fill in the values.

# Database (Prisma SQLite for development; switch to PostgreSQL for production)
DATABASE_URL=file:./dev.db

# Auth — used to sign JWT session tokens. Generate a 32+ char random string.
# Run: openssl rand -hex 32
AUTH_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# Demo data seeding. In development the app seeds demo data on first visit.
# In production seeding is OFF unless you set this to true (demo accounts have known passwords!).
# Set it only for the first deploy, then remove it and delete the demo users.
ALLOW_DEMO_SEED=false

# ────────────────────────────────────────────────────────────
# External integrations (optional — platform works without these)
# ────────────────────────────────────────────────────────────

# Crossref — for DOI publication metadata import (no auth required for polite API)
# Register a "mailto" contact for the polite pool.
CROSSREF_MAILTO=

# OpenAlex — for scholarly metadata (no auth required for polite API)
OPENALEX_MAILTO=

# ORCID — for researcher profile import (requires OAuth registration)
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# Zenodo — for dataset metadata (requires OAuth registration)
ZENODO_CLIENT_ID=
ZENODO_CLIENT_SECRET=

# Email service — for transactional email (notifications, deadline reminders)
# Leave empty to disable email sending; in-app notifications still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Researcher BD <noreply@researcherbd.org>"

# AI provider — optional. Leave empty to keep the AI assistant disabled.
# The core platform works fully without AI.
AI_PROVIDER_API_KEY=

# ────────────────────────────────────────────────────────────
# Production deployment (Vercel + Supabase)
# ────────────────────────────────────────────────────────────
# When migrating to Supabase, replace DATABASE_URL with the Supabase pooler URL:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>-pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@<region>-pooler.supabase.com:5432/postgres
# NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
# Avatar uploads: with NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY set, avatars go to a
# PUBLIC Supabase Storage bucket (default name "avatars", override with SUPABASE_AVATAR_BUCKET).
# Create that bucket in Supabase first. Without them, files are saved to public/uploads (dev only).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=server-only-never-expose-to-client
