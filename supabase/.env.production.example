# ============================================================================
# Researcher BD — Production Environment Variables
# ============================================================================
# Copy these into your hosting provider's environment variable settings
# (e.g., Vercel → Project Settings → Environment Variables).
#
# DO NOT commit actual secret values to Git. Use placeholder values in
# committed files (.env.example) and real values only in your hosting provider.
# ============================================================================

# ─── DATABASE (Supabase PostgreSQL) ─────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → Database → Connection string

# Pooler URL (port 6543) — used by the app at runtime (Prisma Client).
# Required for Vercel serverless functions (avoids exhausting connection pool).
DATABASE_URL="postgresql://postgres.<ref>:<password>@<region>-pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL (port 5432) — used for migrations (prisma db push / migrate).
DIRECT_URL="postgresql://postgres.<ref>:<password>@<region>-pooler.supabase.com:5432/postgres"

# ─── AUTH ───────────────────────────────────────────────────────────────────
# Used to sign JWT session tokens. Generate with: openssl rand -hex 32
AUTH_SECRET="generate-a-32-plus-char-random-string-here"

# ─── SUPABASE (optional — for client-side features and Storage) ─────────────
# Only required if you add Supabase Auth or Storage features later.
# The app currently uses its own JWT auth — these are optional.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-key>"  # SERVER-ONLY — never expose to client

# ─── EXTERNAL INTEGRATIONS (all optional — platform works without them) ─────

# Crossref polite API — register your contact email
CROSSREF_MAILTO="your-email@example.org"

# OpenAlex polite API — same contact email
OPENALEX_MAILTO="your-email@example.org"

# ORCID OAuth — for researcher profile import
# Create at: https://orcid.org/developer-tools
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""

# Zenodo OAuth — for dataset metadata import
# Create at: https://zenodo.org/settings/applications/
ZENODO_CLIENT_ID=""
ZENODO_CLIENT_SECRET=""

# ─── EMAIL (optional — for transactional email) ─────────────────────────────
# Leave empty to disable email sending (in-app notifications still work).
# Recommended: Resend (https://resend.com), free 3,000 emails/month
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Researcher BD <noreply@yourdomain.com>"

# Or use Resend directly:
# RESEND_API_KEY=""

# ─── AI ASSISTANT (optional) ────────────────────────────────────────────────
# Leave empty to keep the AI assistant disabled.
# The core platform works fully without AI.
AI_PROVIDER_API_KEY=""

# ─── APP ────────────────────────────────────────────────────────────────────
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.com"
