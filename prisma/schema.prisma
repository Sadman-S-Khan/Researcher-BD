// Researcher BD — Bangladesh Research & Innovation Network
// Prisma schema (SQLite for development). For production, switch the datasource
// provider to "postgresql" and re-run db:push / migrations.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// IDENTITY & USERS
// ─────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  displayName     String?
  bio             String?
  avatarUrl       String?
  role            UserRole @default(STUDENT)
  isEmailVerified Boolean  @default(false)
  isBanned        Boolean  @default(false)
  locale          String   @default("en")
  theme           String   @default("system")
  isPublic        Boolean  @default(true)
  // Notification preferences — comma-separated list of enabled types.
  // Empty string means all notifications enabled. Types: deadline, collaboration,
  // project, submission, verification, learning, opportunity-match
  notifTypes      String   @default("deadline,collaboration,project,submission,verification,learning,opportunity-match")
  notifEmail      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profile          Profile?
  publications     PublicationAuthor[]  @relation("AuthorPublications")
  importedPubs     Publication[]        @relation("ImportedPublications")
  claimedPubs      PublicationClaim[]
  contributions    Contribution[]
  opportunities    Opportunity[]        @relation("OpportunitySubmitter")
  bookmarks        Bookmark[]
  savedSearches    SavedSearch[]
  projectsOwned    ResearchProject[]    @relation("ProjectOwner")
  projectMembers   ProjectMember[]
  tasksAssigned    ProjectTask[]        @relation("TaskAssignee")
  tasksCreated     ProjectTask[]        @relation("TaskCreator")
  questions        Question[]
  answers          Answer[]
  comments         Comment[]
  votes            Vote[]
  posts            CollaborationPost[]  @relation("PostAuthor")
  requests         CollaborationRequest[]
  events           AcademicEvent[]      @relation("EventSubmitter")
  datasets         Dataset[]            @relation("DatasetSubmitter")
  datasetAuthors   DatasetAuthor[]
  notifications    Notification[]
  reports          Report[]             @relation("ReportReporter")
  reportsHandled   Report[]             @relation("ReportHandler")
  submissions      Submission[]
  auditLogs        AuditLog[]
  orgMemberships   OrganizationMember[]
  orgsOwned        Organization[]       @relation("OrgOwner")
  labMemberships   LaboratoryMember[]
  labsOwned        Laboratory[]         @relation("LabOwner")
  mentorPref       MentorPreference?
  learningProgress LessonProgress[]
  learningMarks    LearningBookmark[]
  organizations    Organization[]       @relation("OrgVerifiedBy")
  journalsVerified Journal[]            @relation("JournalVerifiedBy")
  eventsVerified   AcademicEvent[]      @relation("EventVerifiedBy")
  opportunitiesVer Opportunity[]        @relation("OpportunityVerifiedBy")
  datasetsVer      Dataset[]            @relation("DatasetVerifiedBy")
}

enum UserRole {
  STUDENT
  RESEARCHER
  FACULTY
  ORG_REP
  MODERATOR
  ADMIN
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution     String?
  department      String?
  position        String?
  education       String?
  researchInterests String?
  technicalSkills String?
  orcid           String?
  scholarLink     String?
  githubLink      String?
  linkedinLink    String?
  websiteLink     String?
  location        String?
  contactEmail    String?
  contactPhone    String?
  awards          String?
  experience      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// ACADEMIC RECORDS
// ─────────────────────────────────────────────────────────────

model Publication {
  id             String   @id @default(cuid())
  title          String
  type           String   @default("journal-article")
  authorsList    String   // JSON-encoded array of author names
  abstract       String?
  doi            String?
  venue          String?
  publisher      String?
  year           Int?
  url            String?
  source         String   @default("self-reported") // crossref | openalex | orcid | self-reported
  verification   String   @default("claimed") // claimed | imported | authorship-confirmed | disputed | pending
  userId         String?
  user           User?    @relation("ImportedPublications", fields: [userId], references: [id])
  authors        PublicationAuthor[]
  claims         PublicationClaim[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PublicationAuthor {
  id            String       @id @default(cuid())
  publicationId String
  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation("AuthorPublications", fields: [userId], references: [id])
  name          String
  order         Int          @default(0)
}

model PublicationClaim {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  status        String      @default("pending") // pending | approved | rejected
  evidenceNote  String?
  createdAt     DateTime    @default(now())
}

model Contribution {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String   // journal-article | conference-paper | book | dataset | software | patent | award | mentoring | ...
  title       String
  description String?
  url         String?
  doi         String?
  year        Int?
  verification String  @default("self-reported")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Dataset {
  id              String   @id @default(cuid())
  title           String
  description     String?
  authorsList     String   // JSON array of author names
  researchDomain  String?
  dataModality    String?
  fileFormat      String?
  sampleCount     String?
  license         String?
  doi             String?
  citation        String?
  hostingPlatform String?
  downloadUrl     String?
  associatedPub   String?
  docsUrl         String?
  verification    String   @default("submitted")
  submitterId     String?
  submitter       User?    @relation("DatasetSubmitter", fields: [submitterId], references: [id])
  verifiedById    String?
  verifiedBy      User?    @relation("DatasetVerifiedBy", fields: [verifiedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  authors         DatasetAuthor[]
  bookmarks       Bookmark[] @relation("DatasetBookmarks")
}

model DatasetAuthor {
  id        String  @id @default(cuid())
  datasetId String
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  name      String
  order     Int     @default(0)
}

// ─────────────────────────────────────────────────────────────
// DISCOVERY
// ─────────────────────────────────────────────────────────────

model Opportunity {
  id              String   @id @default(cuid())
  title           String
  description     String
  type            String   // assistantship | internship | scholarship | fellowship | phd | postdoc | job | competition | international
  researchDomain  String?
  organization    String?
  eligibility     String?
  qualifications  String?
  location        String?
  fundingAmount   String?
  deadline        DateTime?
  applicationUrl  String?
  sourceUrl       String?
  publishedAt     DateTime @default(now())
  verification    String   @default("submitted") // submitted | source-checked | expired
  submitterId     String?
  submitter       User?    @relation("OpportunitySubmitter", fields: [submitterId], references: [id])
  verifiedById    String?
  verifiedBy      User?    @relation("OpportunityVerifiedBy", fields: [verifiedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  bookmarks       Bookmark[] @relation("OpportunityBookmarks")
}

model FundingCall {
  id              String   @id @default(cuid())
  title           String
  description     String
  type            String   // government | university | institutional | international | travel | award | innovation
  funder          String?
  amount          String?
  eligibility     String?
  deadline        DateTime?
  url             String?
  sourceUrl       String?
  publishedAt     DateTime @default(now())
  verification    String   @default("submitted")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Journal {
  id              String   @id @default(cuid())
  title           String
  issn            String?
  eissn           String?
  publisher       String?
  subjectAreas    String?
  scope           String?
  website         String?
  doi             String?
  indexingClaims  String?  // free text — never assert without source
  openAccess      Boolean?
  verification    String   @default("listed") // listed | information-checked | under-review
  verifiedById    String?
  verifiedBy      User?    @relation("JournalVerifiedBy", fields: [verifiedById], references: [id])
  lastCheckedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Conference {
  id              String   @id @default(cuid())
  title           String
  organizer       String?
  location        String?
  eventDate       DateTime?
  submissionDeadline DateTime?
  website         String?
  researchTracks  String?
  registrationUrl String?
  proceedings     String?
  publisher       String?
  verification    String   @default("listed")
  lastCheckedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AcademicEvent {
  id              String   @id @default(cuid())
  title           String
  description     String?
  organizer       String?
  eventType       String   // seminar | workshop | bootcamp | webinar | conference | hackathon | thesis | competition | training
  startDateTime   DateTime?
  endDateTime     DateTime?
  location        String?
  mode            String   @default("offline") // offline | online | hybrid
  registrationDeadline DateTime?
  registrationUrl String?
  sourceUrl       String?
  status          String   @default("upcoming") // upcoming | ongoing | ended
  submitterId     String?
  submitter       User?    @relation("EventSubmitter", fields: [submitterId], references: [id])
  verification    String   @default("submitted")
  verifiedById    String?
  verifiedBy      User?    @relation("EventVerifiedBy", fields: [verifiedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Bookmark {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // exactly one of the following target relations is set
  opportunityId String?
  opportunity   Opportunity? @relation("OpportunityBookmarks", fields: [opportunityId], references: [id], onDelete: Cascade)
  datasetId     String?
  dataset       Dataset?     @relation("DatasetBookmarks", fields: [datasetId], references: [id], onDelete: Cascade)
  // generic target stored as text for the rest of discovery types
  targetType    String   // opportunity | funding | journal | conference | dataset | event | researcher | organization | laboratory | learning
  targetId      String
  createdAt     DateTime @default(now())
  @@unique([userId, targetType, targetId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  query     String
  filters   String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// RESEARCH ORGANIZATIONS
// ─────────────────────────────────────────────────────────────

model Organization {
  id            String   @id @default(cuid())
  name          String
  type          String   // university | department | laboratory | centre | group | hub | independent-org
  description   String?
  website       String?
  location      String?
  researchAreas String?
  logoUrl       String?
  contactEmail  String?
  contactPhone  String?
  verification  String   @default("submitted") // submitted | official-source-confirmed
  ownerId       String
  owner         User     @relation("OrgOwner", fields: [ownerId], references: [id])
  verifiedById  String?
  verifiedBy    User?    @relation("OrgVerifiedBy", fields: [verifiedById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       OrganizationMember[]
  laboratories  Laboratory[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner | admin | member
  createdAt      DateTime     @default(now())
  @@unique([organizationId, userId])
}

model Laboratory {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  researchAreas  String?
  location       String?
  website        String?
  verification   String   @default("submitted")
  ownerId        String
  owner          User     @relation("LabOwner", fields: [ownerId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  members        LaboratoryMember[]
}

model LaboratoryMember {
  id           String     @id @default(cuid())
  laboratoryId String
  laboratory   Laboratory @relation(fields: [laboratoryId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         String     @default("member")
  createdAt    DateTime   @default(now())
  @@unique([laboratoryId, userId])
}

// ─────────────────────────────────────────────────────────────
// COLLABORATION & MENTORING
// ─────────────────────────────────────────────────────────────

model CollaborationPost {
  id            String   @id @default(cuid())
  authorId      String
  author        User     @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title         String
  body          String
  category      String   // collaboration | research-assistant | mentorship | co-author | project-partner
  researchArea  String?
  status        String   @default("open") // open | closed
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  requests      CollaborationRequest[]
}

model CollaborationRequest {
  id        String   @id @default(cuid())
  postId    String
  post      CollaborationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String?
  status    String   @default("pending") // pending | accepted | rejected
  createdAt DateTime @default(now())
}

model MentorPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isAvailable        Boolean  @default(false)
    researchAreas     String?
  preferredSkills    String?
  currentProjects    String?
  collaborationNotes String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// LEARNING HUB
// ─────────────────────────────────────────────────────────────

model LearningCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameEn      String
  nameBn      String
  descriptionEn String?
  descriptionBn String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  paths       LearningPath[]
  lessons     Lesson[]
}

model LearningPath {
  id           String   @id @default(cuid())
  slug         String   @unique
  titleEn      String
  titleBn      String
  descriptionEn String?
  descriptionBn String?
  categoryId   String?
  category     LearningCategory? @relation(fields: [categoryId], references: [id])
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  lessons      Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleEn     String
  titleBn     String
  bodyEn      String
  bodyBn      String
  category    String?  // fundamentals | literature | data-analysis | tools | writing | ethics
  categoryId  String?
  categoryRef LearningCategory? @relation(fields: [categoryId], references: [id])
  pathId      String?
  path        LearningPath? @relation(fields: [pathId], references: [id])
  resourceUrl String?
  durationMin Int      @default(15)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  progress    LessonProgress[]
  bookmarks   LearningBookmark[]
}

model LessonProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  @@unique([userId, lessonId])
}

model LearningBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, lessonId])
}

// ─────────────────────────────────────────────────────────────
// COMMUNITY
// ─────────────────────────────────────────────────────────────

model DiscussionCategory {
  id      String   @id @default(cuid())
  slug    String   @unique
  nameEn  String
  nameBn  String
  order   Int      @default(0)
  questions Question[]
}

model Question {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  body        String
  categoryId  String?
  category    DiscussionCategory? @relation(fields: [categoryId], references: [id])
  tags        String?
  views       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  answers     Answer[]
  comments    Comment[]
}

model Answer {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  body        String
  isAccepted  Boolean  @default(false)
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    Comment[]
  votes       Vote[]
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  questionId String?
  question  Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerId  String?
  answer    Answer?   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answerId  String?
  answer    Answer?  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  value     Int      @default(1)
  createdAt DateTime @default(now())
  @@unique([userId, answerId])
}

// ─────────────────────────────────────────────────────────────
// PROJECTS
// ─────────────────────────────────────────────────────────────

model ResearchProject {
  id            String   @id @default(cuid())
  title         String
  description   String?
  researchDomain String?
  objectives    String?
  status        String   @default("planning") // planning | active | on-hold | completed | cancelled
  isPrivate     Boolean  @default(true)
  startDate     DateTime?
  expectedEnd   DateTime?
  ownerId       String
  owner         User     @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       ProjectMember[]
  tasks         ProjectTask[]
  milestones    ProjectMilestone[]
  resources     ProjectResource[]
  notes         ProjectNote[]
}

model ProjectMember {
  id        String         @id @default(cuid())
  projectId String
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String         @default("member") // owner | lead | member | viewer
  createdAt DateTime       @default(now())
  @@unique([projectId, userId])
}

model ProjectTask {
  id          String   @id @default(cuid())
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      String   @default("todo") // todo | in-progress | review | done
  priority    String   @default("medium") // low | medium | high | urgent
  dueDate     DateTime?
  assigneeId  String?
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdById String?
  createdBy   User?    @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectMilestone {
  id        String   @id @default(cuid())
  projectId String
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ProjectResource {
  id        String   @id @default(cuid())
  projectId String
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  url       String?
  notes     String?
  createdAt DateTime @default(now())
}

model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  body      String
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// SYSTEM
// ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // deadline | collaboration | project | submission | verification | learning | opportunity-match
  title     String
  body      String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Report {
  id           String   @id @default(cuid())
  reporterId   String
  reporter     User     @relation("ReportReporter", fields: [reporterId], references: [id])
  targetType   String
  targetId     String
  reason       String
  status       String   @default("open") // open | reviewing | resolved | dismissed
  handlerId    String?
  handler      User?    @relation("ReportHandler", fields: [handlerId], references: [id])
  resolution   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Submission {
  id          String   @id @default(cuid())
  submitterId String
  submitter   User     @relation(fields: [submitterId], references: [id])
  entityType  String   // opportunity | journal | conference | dataset | event | organization | laboratory
  entityId    String
  status      String   @default("pending") // pending | approved | rejected
  reviewerId  String?
  reviewNote  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  targetType String?
  targetId  String?
  metadata  String?
  createdAt DateTime @default(now())
}

model SystemSetting {
  id    String @id
  key   String @unique
  value String
}
